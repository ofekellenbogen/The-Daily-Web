# Copy this file to .env and fill in the values. Never commit .env (it contains secrets).

# Full MongoDB connection string (ask a teammate for the team's Atlas URI).
MONGODB_URI=

# Database name inside the cluster (default: daily-web).
MONGODB_DB=daily-web

# Port the server listens on (default: 3000).
PORT=3000

# Set to "production" when serving over HTTPS (makes cookies Secure).
# NODE_ENV=production
