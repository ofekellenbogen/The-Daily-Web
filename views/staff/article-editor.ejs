<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/layout/head', { title }) %>
  <link rel="stylesheet" href="/css/staff.css">
</head>
<body>
  <%- include('../partials/layout/header') %>
  <%# Article editor for reporters and editors. `article` is null for a new article.
      Saving and the workflow buttons are handled by /js/article-editor.js. %>
  <% const content = article?.workingCopy || {}; %>
  <% const status = article?.workflowStatus || 'draft'; %>
  <% const isEditor = currentUser.role === 'editor'; %>
  <%# A reporter can't edit an article while it waits for an editor's review. %>
  <% const locked = !isEditor && status === 'pending'; %>

  <main class="container staff-page article-workspace" id="article-editor"
        data-article-id="<%= article?._id || '' %>"
        data-user-id="<%= currentUser._id %>"
        data-role="<%= currentUser.role %>"
        data-workflow-status="<%= status %>">
    <h1><%= title %></h1>
    <% if (article) { %>
      <p id="article-state" class="workflow-badge workflow-badge--<%= status %>"><span aria-hidden="true"></span>מצב: <strong><%= statusLabels[status] %></strong></p>
    <% } %>
    <% if (article?.editorNote) { %><p class="staff-card">הערת עורך: <%= article.editorNote %></p><% } %>
    <% if (locked) { %><p>הכתבה ממתינה לאישור עורך ולא ניתן לערוך אותה כרגע.</p><% } %>

    <%# Autosave status ("saving...", "all changes saved", errors). aria-live reads it to screen readers. %>
    <p id="staff-status" class="save-feedback" role="status" aria-live="polite" aria-atomic="true"></p>

    <form id="article-form" class="staff-form">
      <fieldset class="draft-editor-panel" <%= locked ? 'disabled' : '' %>>
        <legend><%= isEditor ? (status === 'pending' ? 'התוכן שהוגש לאישור' : 'גרסת העבודה') : 'תוכן הכתבה' %></legend>
        <% if (article?.publishedVersion) { %><p>השינויים בגרסת העבודה יוצגו לציבור רק לאחר אישור עורך.</p><% } %>

        <label for="article-title">כותרת</label>
        <input id="article-title" name="title" maxlength="200" value="<%= content.title || '' %>">

        <label for="article-summary">תקציר</label>
        <textarea id="article-summary" name="summary" maxlength="1000" rows="3"><%= content.summary || '' %></textarea>

        <label for="article-body">תוכן</label>
        <textarea id="article-body" name="body" maxlength="50000" rows="14"><%= content.body || '' %></textarea>

        <label for="article-category">קטגוריה</label>
        <select id="article-category" name="category" required>
          <% for (const [value, label] of Object.entries(categories)) { %>
            <option value="<%= value %>" <%= content.category === value ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>

        <label for="article-image">כתובת תמונה (לא חובה; ללא כתובת תוצג תמונת ברירת מחדל)</label>
        <input id="article-image" name="imageUrl" type="text" inputmode="url" maxlength="2000" dir="ltr" value="<%= content.imageUrl || '' %>">
        <figure class="article-image-preview" id="draft-image-preview" <%= content.imageUrl ? '' : 'hidden' %>>
          <img <% if (content.imageUrl) { %>src="<%= content.imageUrl %>"<% } %> alt="<%= content.imageAlt || 'תצוגה מקדימה של תמונת הכתבה' %>" loading="lazy">
          <figcaption>תצוגה מקדימה של תמונת גרסת העבודה</figcaption>
        </figure>

      </fieldset>
    </form>

    <%# Workflow buttons. The server checks every permission again - these are only shortcuts.
        article-editor.js hides the buttons that don't fit the current state. %>
    <section class="staff-actions" aria-label="פעולות בכתבה">
      <% if (!isEditor) { %>
        <button class="button" type="button" data-action="submit">שמירה ושליחה לאישור עורך</button>
      <% } else { %>
        <button class="button" type="button" data-action="approve">שמירה ואישור פרסום</button>
        <% if (status === 'pending') { %>
          <label for="editor-note">הערה להחזרה לתיקונים</label>
          <textarea id="editor-note" maxlength="1000" rows="3"></textarea>
          <button class="button button--secondary" type="button" data-action="return">שמירה והחזרה לתיקונים</button>
        <% } %>
        <% if (article) { %><button class="button button--secondary" type="button" data-action="delete">מחיקת כתבה</button><% } %>
      <% } %>
    </section>

    <%# Editors see the currently published version next to the new content, to compare them. %>
    <% if (isEditor && article?.publishedVersion) { %>
      <% const published = article.publishedVersion; %>
      <section id="approved-snapshot" class="staff-card approved-snapshot-card" aria-labelledby="published-title">
        <h2 id="published-title">הגרסה המפורסמת כעת</h2>
        <p>גרסה <%= published.version %> · קטגוריה: <%= categories[published.category] %></p>
        <h3><%= published.title %></h3>
        <p><%= published.summary %></p>
        <% if (published.imageUrl) { %>
          <img class="published-image" src="<%= published.imageUrl %>" alt="<%= published.imageAlt || published.title %>" loading="lazy">
          <p class="published-body">תמונה: <%= published.imageUrl %></p>
          <% if (published.imageCredit || published.imageLicense) { %>
            <p class="published-body">קרדיט: <%= published.imageCredit %> · <%= published.imageLicense %></p>
            <% if (published.imageSourceUrl) { %><p class="published-body">מקור: <%= published.imageSourceUrl %></p><% } %>
          <% } %>
        <% } %>
        <div class="approved-snapshot-card__body">
          <p class="published-body"><%= published.body %></p>
        </div>
      </section>
    <% } %>

    <a href="<%= isEditor ? '/editor' : '/reporter' %>">חזרה לאזור העבודה</a>
    <noscript><p>יש להפעיל JavaScript כדי לשמור ולנהל כתבות.</p></noscript>
  </main>
  <%- include('../partials/layout/footer') %>
  <script src="/js/article-editor.js" defer></script>
</body>
</html>
