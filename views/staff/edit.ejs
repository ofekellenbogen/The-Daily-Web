<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/layout/head', { title }) %>
  <link rel="stylesheet" href="/css/staff.css">
</head>
<body>
  <%- include('../partials/layout/header') %>
  <% const content = article?.workingCopy || {}; %>
  <% const locked = currentUser.role === 'reporter' && article?.workflowStatus === 'pending'; %>
  <main class="container staff-page article-workspace" id="article-editor" data-article-id="<%= article?._id || '' %>">
    <h1><%= title %></h1>
    <% if (article) { %><p id="article-state" class="workflow-badge workflow-badge--<%= article.workflowStatus %>"><span aria-hidden="true"></span>מצב: <strong><%= statusLabels[article.workflowStatus] %></strong></p><% } %>
    <% if (article?.editorNote) { %><p class="staff-card">הערת עורך: <%= article.editorNote %></p><% } %>
    <% if (locked) { %><p>הכתבה ממתינה לאישור עורך ולא ניתן לערוך אותה כרגע.</p><% } %>
    <p id="staff-status" role="status" aria-live="polite"></p>
    <form id="article-form" class="staff-form">
      <fieldset class="draft-editor-panel" <%= locked ? 'disabled' : '' %>>
        <legend><%= currentUser.role === 'editor' ? (article?.workflowStatus === 'pending' ? 'התוכן שהוגש לאישור' : 'גרסת העבודה') : 'תוכן הכתבה' %></legend>
        <% if (article?.publishedVersion) { %><p>השינויים בגרסת העבודה יוצגו לציבור רק לאחר אישור עורך.</p><% } %>
        <label for="article-title">כותרת</label>
        <input id="article-title" name="title" maxlength="200" value="<%= content.title || '' %>">
        <label for="article-summary">תקציר</label>
        <textarea id="article-summary" name="summary" maxlength="1000" rows="3"><%= content.summary || '' %></textarea>
        <label for="article-body">תוכן</label>
        <textarea id="article-body" name="body" maxlength="50000" rows="14"><%= content.body || '' %></textarea>
        <label for="article-category">קטגוריה</label>
        <select id="article-category" name="category" required>
          <% for (const [value, label] of Object.entries(categories)) { %>
            <option value="<%= value %>" <%= content.category === value ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
        <label for="article-image">כתובת תמונה</label>
        <input id="article-image" name="imageUrl" type="url" maxlength="2000" dir="ltr" value="<%= content.imageUrl || '' %>">
          <figure class="article-image-preview" id="draft-image-preview" <%= content.imageUrl ? '' : 'hidden' %>>
            <img <% if (content.imageUrl) { %>src="<%= content.imageUrl %>"<% } %> alt="תצוגה מקדימה של תמונת הכתבה" loading="lazy">
            <figcaption>תצוגה מקדימה של תמונת גרסת העבודה</figcaption>
          </figure>
        <button class="button" type="submit">שמירת כתבה</button>
      </fieldset>
    </form>
    <% if (article) { %>
      <section class="staff-actions" aria-label="פעולות בכתבה">
        <% if (currentUser.role === 'reporter' && ['draft', 'returned', 'published'].includes(article.workflowStatus)) { %>
          <button class="button" type="button" data-action="submit">שמירה ושליחה לאישור עורך</button>
        <% } %>
        <% if (currentUser.role === 'editor') { %>
          <% if (article.workflowStatus === 'pending') { %>
            <button class="button" type="button" data-action="approve">שמירה ואישור פרסום</button>
            <label for="editor-note">הערה להחזרה לתיקונים</label>
            <textarea id="editor-note" maxlength="1000" rows="3"></textarea>
            <button class="button button--secondary" type="button" data-action="return">שמירה והחזרה לתיקונים</button>
          <% } %>
          <button class="button button--secondary" type="button" data-action="delete">מחיקת כתבה</button>
        <% } %>
      </section>
      <% if (currentUser.role === 'editor' && article.publishedVersion) { %>
        <section id="approved-snapshot" class="staff-card approved-snapshot-card" aria-labelledby="published-title">
          <h2 id="published-title">הגרסה המפורסמת כעת</h2>
          <p>גרסה <%= article.publishedVersion.version %> · קטגוריה: <%= categories[article.publishedVersion.category] %></p>
          <h3><%= article.publishedVersion.title %></h3>
          <p><%= article.publishedVersion.summary %></p>
          <% if (article.publishedVersion.imageUrl) { %>
            <img class="published-image" src="<%= article.publishedVersion.imageUrl %>" alt="<%= article.publishedVersion.title %>" loading="lazy">
            <p class="published-body">תמונה: <%= article.publishedVersion.imageUrl %></p>
          <% } %>
          <div class="approved-snapshot-card__body">
            <p class="published-body"><%= article.publishedVersion.body %></p>
          </div>
        </section>
      <% } %>
    <% } %>
    <a href="<%= currentUser.role === 'editor' ? '/editor' : '/reporter' %>">חזרה לאזור העבודה</a>
    <noscript><p>יש להפעיל JavaScript כדי לשמור ולנהל כתבות.</p></noscript>
  </main>
  <p id="snapshot-status" class="container" role="status" aria-live="polite"></p>
  <script src="/js/editor-view.js" data-initial-status="<%= article?.workflowStatus || 'draft' %>" data-role="<%= currentUser.role %>" defer></script>
  <%- include('../partials/layout/footer') %>
  <script src="/js/staff.js" defer></script>
</body>
</html>
