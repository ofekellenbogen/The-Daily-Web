<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/layout/head', { title }) %>
  <link rel="stylesheet" href="/css/staff.css">
</head>
<body>
  <%- include('../partials/layout/header') %>
  <main class="container staff-page">
    <div class="staff-page__heading">
      <h1><%= title %></h1>
      <% if (currentUser.role === 'reporter') { %>
        <a class="button button--primary" href="/staff/articles/new">יצירת כתבה חדשה</a>
      <% } %>
    </div>

    <form class="staff-filter" id="workspace-filter" method="get">
      <label for="workspace-status-filter">סינון לפי מצב</label>
      <select id="workspace-status-filter" name="status">
        <option value="">כל המצבים</option>
        <% for (const [value, label] of Object.entries(statusLabels)) { %>
          <option value="<%= value %>" <%= selectedStatus === value ? 'selected' : '' %>><%= label %></option>
        <% } %>
      </select>
      <button class="button" type="submit">סינון</button>
    </form>

    <p id="workspace-status" role="status" aria-live="polite"><%= articles.length ? '' : 'אין עדיין כתבות להצגה.' %></p>
    <ul class="article-list" id="workspace-articles" data-user-role="<%= currentUser.role %>" aria-label="כתבות לניהול">
      <% for (const article of articles) { %>
        <li>
          <article class="staff-card staff-card--<%= article.workflowStatus %>">
            <h2><a href="/staff/articles/<%= article._id %>"><%= article.workingCopy.title || 'ללא כותרת' %></a></h2>
            <p class="staff-card__status">מצב: <span class="status-badge status-badge--<%= article.workflowStatus %>"><%= statusLabels[article.workflowStatus] %></span></p>
            <% if (currentUser.role === 'editor') { %><p class="staff-card__author">כתב: <%= article.authorId?.displayName || 'משתמש לא זמין' %></p><% } %>
            <% if (article.editorNote) { %>
              <div class="editor-note-box">
                <strong>הערת עורך לתיקונים:</strong>
                <p><%= article.editorNote %></p>
              </div>
            <% } %>
            <% if (article.workflowStatus === 'published') { %>
              <p class="staff-card__public-link">
                <a href="/articles/<%= article._id %>" target="_blank" rel="noopener">צפייה בכתבה המפורסמת ↗</a>
              </p>
            <% } %>
          </article>
        </li>
      <% } %>
    </ul>
    <button class="button" id="workspace-more" type="button" data-next-page="<%= nextPage || '' %>" <%= nextPage ? '' : 'hidden' %>>טעינת כתבות נוספות</button>
    <% if (nextPage) { %>
      <noscript><a href="?page=<%= nextPage %>&amp;status=<%= selectedStatus %>">לעמוד הבא</a></noscript>
    <% } %>
  </main>
  <%- include('../partials/layout/footer') %>
  <script src="/js/workspace.js" defer></script>
</body>
</html>
