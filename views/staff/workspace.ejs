<!DOCTYPE html>
<%# Staff workspace - article list. GET /reporter or GET /editor -> staff.controller.workspace.
    Receives: title, articles (first page; reporter = own articles, editor = all), nextPage,
    selectedStatus, selectedQuery, statusLabels (+ currentUser from res.locals).
    The first page is rendered on the server; /js/workspace.js filters live and loads more pages
    from /api/staff/articles. The noscript parts keep filtering/paging working without JS. %>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/layout/head', { title }) %>
  <%# Reuses the feed heading/filter styles from public.css, so it loads before staff.css. %>
  <link rel="stylesheet" href="/css/public.css">
  <link rel="stylesheet" href="/css/staff.css">
</head>
<body>
  <%- include('../partials/layout/header') %>
  <main class="container staff-page workspace-page">
    <div class="feed-heading">
      <h1><%= title %></h1>
      <span class="feed-heading__rule" aria-hidden="true"></span>
    </div>
    <%# A normal GET form (?q=&status=): with JS, workspace.js filters without reloading;
        without JS, the noscript submit button reloads the page with the filters. %>
    <form class="feed-controls workspace-controls" id="workspace-filter" method="get" role="search">
      <div class="field field--search">
        <label for="workspace-query">חיפוש</label>
        <input type="search" id="workspace-query" name="q" maxlength="100" value="<%= selectedQuery %>" placeholder="חיפוש לפי כותרת..." autocomplete="off">
      </div>
      <div class="field">
        <label for="workspace-status-filter">מצב הכתבה</label>
        <select id="workspace-status-filter" name="status">
          <option value="">כל המצבים</option>
          <% for (const [value, label] of Object.entries(statusLabels)) { %>
            <option value="<%= value %>" <%= selectedStatus === value ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <noscript><button class="button" type="submit">חיפוש וסינון</button></noscript>
    </form>
    <a class="button" href="/staff/articles/new">יצירת כתבה חדשה</a>
    <%# "Empty list" text from the server; workspace.js updates it (aria-live announces changes). %>
    <p id="workspace-status" role="status" aria-live="polite"><%= articles.length ? '' : 'אין עדיין כתבות להצגה.' %></p>
    <%# Server-rendered first page of cards. Each card links to the editor page. %>
    <ul class="article-list" id="workspace-articles" aria-label="כתבות לניהול" data-role="<%= currentUser.role %>">
      <% for (const article of articles) { %>
        <li>
          <article class="staff-card workspace-card" data-workflow-status="<%= article.workflowStatus %>">
            <%# Article image, or a text placeholder when there is no image. %>
            <% if (article.imageUrl) { %><img class="workspace-card__image" src="<%= article.imageUrl %>" alt="<%= article.imageAlt || article.workingCopy.title %>" loading="lazy"><% } else { %><div class="workspace-card__image workspace-card__image--empty" aria-hidden="true">The Daily Web</div><% } %>
            <h2><a href="/staff/articles/<%= article._id %>"><%= article.workingCopy.title || 'ללא כותרת' %></a></h2>
            <p>מצב: <%= statusLabels[article.workflowStatus] %></p>
            <%# An article that is live but has an unapproved update in progress. %>
            <% if (article.publishedVersion && article.workflowStatus !== 'published') { %><p class="live-note">מפורסמת באתר (הגרסה המאושרת)</p><% } %>
            <%# Only editors see the author name (reporters only see their own articles). %>
            <% if (currentUser.role === 'editor') { %><p>כתב: <%= article.authorId?.displayName || 'משתמש לא זמין' %></p><% } %>
            <% if (article.editorNote) { %><p>הערת עורך: <%= article.editorNote %></p><% } %>
          </article>
        </li>
      <% } %>
    </ul>
    <%# "Load more" (JS) stores the next page number in data-next-page; the noscript link is the no-JS fallback. %>
    <button class="button" id="workspace-more" type="button" data-next-page="<%= nextPage || '' %>" <%= nextPage ? '' : 'hidden' %>>טעינת כתבות נוספות</button>
    <% if (nextPage) { %>
      <noscript><a href="?page=<%= nextPage %>&amp;status=<%= encodeURIComponent(selectedStatus) %>&amp;q=<%= encodeURIComponent(selectedQuery) %>">לעמוד הבא</a></noscript>
    <% } %>
  </main>
  <%- include('../partials/layout/footer') %>
  <script src="/js/workspace.js" defer></script>
</body>
</html>
