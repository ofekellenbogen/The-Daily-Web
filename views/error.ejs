<!DOCTYPE html>
<%# Error page (404 / 500 / 4xx). Rendered by src/middleware/errorHandler.js (notFound + errorHandler).
    Receives: title, status (HTTP code), message (safe text chosen by the server). No client script. %>
<html lang="he" dir="rtl">
<head>
  <%- include('partials/layout/head', { title }) %>
</head>
<body>
  <%- include('partials/layout/header') %>
  <main class="container error-page">
    <h1><%= status %></h1>
    <p><%= message %></p>
    <a class="button" href="/">חזרה לעמוד הבית</a>
  </main>
  <%- include('partials/layout/footer') %>
</body>
</html>
