<!DOCTYPE html>
<%# Public article page. GET /articles/:id -> article.controller.renderArticle.
    Receives: title, article (published version + categoryLabel, paragraphs, isUpdate...), comments,
    commentCount, formatDate. The whole article is rendered on the server (SEO, works without JS);
    /js/comments.js only drives the comments section. %>
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/layout/head', { title, description: article.summary }) %>
  <link rel="stylesheet" href="/css/public.css">
</head>
<body>
  <%- include('../partials/layout/header') %>

  <main class="container article-page" id="main">
    <nav class="back-link" aria-label="ניווט">
      <a href="/">חזרה לכל הכתבות</a>
    </nav>

    <article class="article">
      <header class="article__header">
        <span class="badge"><%= article.categoryLabel %></span>
        <h1 class="article__title"><%= article.title %></h1>
        <% if (article.summary) { %>
          <p class="article__summary"><%= article.summary %></p>
        <% } %>
        <p class="article__meta">
          <span>מאת <strong><%= article.authorName %></strong></span>
          <span>
            פורסם
            <time datetime="<%= article.firstPublishedAt.toISOString() %>"><%= formatDate(article.firstPublishedAt) %></time>
          </span>
          <%# "Updated" date is shown only when a newer version was published after the first one. %>
          <% if (article.isUpdate) { %>
            <span>
              עודכן
              <time datetime="<%= article.publishedAt.toISOString() %>"><%= formatDate(article.publishedAt) %></time>
            </span>
          <% } %>
        </p>
      </header>

      <figure class="article__figure">
        <img src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>" width="640" height="360">
        <%# Image credit / source / license links, only when that data exists. %>
        <% if (article.imageCredit || article.imageSourceUrl || article.imageLicense) { %>
          <figcaption class="article__image-credit">
            <span>תמונת המחשה</span>
            <% if (article.imageCredit) { %><span>קרדיט: <%= article.imageCredit %></span><% } %>
            <% if (article.imageSourceUrl) { %><a href="<%= article.imageSourceUrl %>" target="_blank" rel="noopener noreferrer">מקור התמונה</a><% } %>
            <% if (article.imageLicenseUrl) { %><a href="<%= article.imageLicenseUrl %>" target="_blank" rel="license noopener noreferrer"><%= article.imageLicense || 'פרטי רישיון' %></a><% } else if (article.imageLicense) { %><span><%= article.imageLicense %></span><% } %>
          </figcaption>
        <% } %>
      </figure>

      <%# Body text split into paragraphs on the server; each one is escaped, so no HTML from the author runs. %>
      <div class="article__body">
        <% for (const paragraph of article.paragraphs) { %>
          <p><%= paragraph %></p>
        <% } %>
      </div>
    </article>

    <%- include('../partials/comments', { articleId: article.id, comments, commentCount, formatDate }) %>
  </main>

  <%- include('../partials/layout/footer') %>
  <script src="/js/comments.js" defer></script>
</body>
</html>
